.page {
  --bg: #f2f2f7;
  --surface: #ffffff;
  --surface-2: #f2f2f7;
  --line: rgba(60, 60, 67, 0.14);
  --line-2: rgba(60, 60, 67, 0.28);
  --ink: #1c1c1e;
  --ink-2: #48484a;
  --ink-3: #8e8e93;
  --accent: #007aff;
  --accent-soft: rgba(0, 122, 255, 0.12);
  --done: #34c759;
  --exam: #ff3b30;
  --exam-soft: rgba(255, 59, 48, 0.12);
  --shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04), 0 18rpx 44rpx -24rpx rgba(0, 0, 0, 0.16);

  min-height: 100vh;
  padding: 8rpx 24rpx 40rpx;
  box-sizing: border-box;
  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

.page.theme-dark {
  --bg: #000000;
  --surface: #1c1c1e;
  --surface-2: #2c2c2e;
  --line: rgba(84, 84, 88, 0.42);
  --line-2: rgba(84, 84, 88, 0.66);
  --ink: #ffffff;
  --ink-2: #aeaeb2;
  --ink-3: #8e8e93;
  --accent: #0a84ff;
  --accent-soft: rgba(10, 132, 255, 0.26);
  --done: #30d158;
  --exam: #ff453a;
  --exam-soft: rgba(255, 69, 58, 0.22);
  --shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.4), 0 18rpx 44rpx -24rpx rgba(0, 0, 0, 0.8);
}

.group-title {
  padding: 26rpx 12rpx 12rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 1rpx;
}

.card {
  padding: 6rpx 24rpx;
  background: var(--surface);
  border-radius: 26rpx;
  box-shadow: var(--shadow);
}

.row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.row:last-child {
  border-bottom: none;
}

.row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.label {
  font-size: 27rpx;
  color: var(--ink);
}

.label.danger {
  color: var(--exam);
}

.sub {
  margin-top: 6rpx;
  font-size: 21rpx;
  line-height: 1.45;
  color: var(--ink-3);
}

.pill {
  padding: 8rpx 22rpx;
  font-size: 25rpx;
  color: var(--accent);
  background: var(--accent-soft);
  border-radius: 12rpx;
}

.chev {
  font-size: 30rpx;
  color: var(--ink-3);
}

.block {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.weeks {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.wk {
  width: 72rpx;
  height: 64rpx;
  line-height: 62rpx;
  margin: 0 12rpx 10rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: var(--ink-2);
  background: var(--surface-2);
  border: 1rpx solid transparent;
  border-radius: 14rpx;
}

.wk.on {
  color: #fff;
  background: var(--accent);
  border-color: var(--accent);
  font-weight: 600;
}

.modes {
  display: flex;
  padding: 10rpx 0;
}

.mode {
  flex: 1;
  margin: 12rpx 8rpx;
  padding: 18rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: var(--ink-2);
  background: var(--surface-2);
  border: 1rpx solid transparent;
  border-radius: 16rpx;
}

.mode.on {
  color: var(--accent);
  background: var(--accent-soft);
  border-color: var(--accent);
  font-weight: 600;
}

.about {
  padding: 24rpx;
}

.about-line {
  display: block;
  font-size: 22rpx;
  line-height: 1.8;
  color: var(--ink-3);
  margin-bottom: 8rpx;
}

.pad {
  height: 40rpx;
}
